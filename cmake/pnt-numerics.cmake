# Prefer a distribution Eigen package (Linux); otherwise use a pinned upstream
# archive, also available in the Windows dependency cache for offline rebuilds.
find_package(Eigen3 3.4 QUIET NO_MODULE)
if(NOT Eigen3_FOUND)
    include(FetchContent)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    set(_eigen_archive "${PROJECT_SOURCE_DIR}/build/native-downloads/eigen-3.4.0.tar.gz")
    if(NOT EXISTS "${_eigen_archive}")
        set(_eigen_archive "https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz")
    endif()
    FetchContent_Declare(ngene_eigen URL "${_eigen_archive}" SOURCE_SUBDIR ngene-headers-only
        URL_HASH SHA256=8586084f71f9bde545ee7fa6d00288b264a2b7ac3607b974e54d13e7162c1c72)
    FetchContent_MakeAvailable(ngene_eigen)
    add_library(ngene_eigen_headers INTERFACE)
    target_include_directories(ngene_eigen_headers SYSTEM INTERFACE "${ngene_eigen_SOURCE_DIR}")
    add_library(Eigen3::Eigen ALIAS ngene_eigen_headers)
endif()
add_library(ngene_pnt_numerics STATIC pvt/pntNumerics.cpp)
target_link_libraries(ngene_pnt_numerics PRIVATE Eigen3::Eigen)
target_compile_features(ngene_pnt_numerics PRIVATE cxx_std_17)
target_compile_definitions(ngene_pnt_numerics PRIVATE EIGEN_MPL2_ONLY EIGEN_DONT_PARALLELIZE)
target_compile_options(ngene_pnt_numerics PRIVATE ${NGENE_OPTIMIZE})
if(NGENE_NATIVE_WINDOWS)
    target_compile_options(ngene_pnt_numerics PRIVATE /EHsc)
endif()
