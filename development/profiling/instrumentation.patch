diff --git a/utility/profilingSupport.c b/utility/profilingSupport.c
index 1d8d8b9..2f13641 100644
--- a/utility/profilingSupport.c
+++ b/utility/profilingSupport.c
@@ -20,6 +20,9 @@ void InitProfilingSupport(TProfilingSupport *prof,char *targetName)
 	prof->numberOfExecutions = 0;
 	prof->numberOfExecutionsOld= 0;
 	prof->totalTimeS = 0.0;
+	prof->lastTimeS = 0.0;
+	prof->maximumTimeS = 0.0;
+	prof->advancedSamples = 0;
 	prof->startTimeS = INVALID_PROFILING_TIME;
 	prof->endTimeS = INVALID_PROFILING_TIME;
 	// prof->tv overwritten at each execution
@@ -56,7 +59,10 @@ void StopProfilingUpdate(TProfilingSupport *prof,unsigned int numberOfExecutions
 		prof->endTimeS = prof->tv.tv_sec + (prof->tv.tv_usec*FROM_MICROSECONDS_TO_SECONDS);
 		#endif
 
-		prof->totalTimeS += (prof->endTimeS-prof->startTimeS);
+		prof->lastTimeS = prof->endTimeS-prof->startTimeS;
+		prof->totalTimeS += prof->lastTimeS;
+		if (prof->lastTimeS > prof->maximumTimeS)
+			prof->maximumTimeS = prof->lastTimeS;
 		prof->numberOfExecutionsOld=prof->numberOfExecutions;
 		prof->numberOfExecutions +=  numberOfExecutions;
 	}
@@ -83,12 +89,21 @@ void ReportProfilingData(TProfilingSupport *prof)
 
 	timeUs = (prof->totalTimeS/(double)prof->numberOfExecutions)/FROM_MICROSECONDS_TO_SECONDS;
 	profFile = fopen(PROFILING_RESULT_FILENAME,"at");
+	if (profFile == NULL) {
+		fprintf(stderr, "Cannot write %s\n", PROFILING_RESULT_FILENAME);
+		return;
+	}
+	/* In append mode the initial position can still be zero on Windows. */
+	if (fseek(profFile, 0, SEEK_END) != 0) {
+		fclose(profFile);
+		return;
+	}
 	if(ftell(profFile)==0)
 	{
 		/* file is empty, print a header */
-		fprintf(profFile,"Target name,Number of executions,Total time [s],Time per execution [us]\n");
+		fprintf(profFile,"Target name,Number of executions,Total time [s],Time per execution [us],Maximum timed interval [us],Advanced channel samples\n");
 	}
-	fprintf(profFile,"%s,%u,%f,%f\n",prof->targetName,prof->numberOfExecutions,prof->totalTimeS,timeUs);
+	fprintf(profFile,"%s,%u,%f,%f,%f,%llu\n",prof->targetName,prof->numberOfExecutions,prof->totalTimeS,timeUs,prof->maximumTimeS*1e6,prof->advancedSamples);
 	fclose(profFile);
 }
 
@@ -108,6 +123,9 @@ void TotalTimeProfilingUpdate(TProfilingSupport *prof)
 	prof->endTimeS = prof->tv.tv_sec + (prof->tv.tv_usec*FROM_MICROSECONDS_TO_SECONDS);
 	#endif
 
-	prof->totalTimeS += (prof->endTimeS-prof->startTimeS);
+	prof->lastTimeS = prof->endTimeS-prof->startTimeS;
+	prof->totalTimeS += prof->lastTimeS;
+	if (prof->lastTimeS > prof->maximumTimeS)
+		prof->maximumTimeS = prof->lastTimeS;
 
 }
